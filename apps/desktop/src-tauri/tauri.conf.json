{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2/tooling/cli/schema.json",
  "productName": "Git Manager",
  "version": "0.1.1",
  "identifier": "com.gitmanager.desktop",
  "build": {
    "beforeDevCommand": "npx pnpm dev:frontend",
    "devUrl": "http://localhost:1428",
    "beforeBuildCommand": "npx pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Manager",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost https: data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:git_manager.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzOEVGOEIzN0I0QzUzMEUKUldRT1UweDdzL2lPVTRScnRteTBsZEYxOWpGVDFaTHc1VkxjSS8xa1Vtd0xXUDR0NEVuQjJZaTMK",
      "endpoints": [
        "https://github.com/SpiritUrban/git-manager/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Vitaliy Dyachuk",
    "copyright": "Copyright (c) 2026 Vitaliy Dyachuk",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
